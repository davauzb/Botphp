# Bu faylni .env nomi bilan nusxalang va to'ldiring:  cp .env.example .env
# .env faylini hech qachon GitHub'ga yuklamang!

# --- Yordamchining shaxsiyati ---
ASSISTANT_NAME=Lola
ASSISTANT_PERSONA=Samimiy, aqlli va hazilkash yordamchi. Har doim yordam berishga tayyor.

# --- AI "miyalar" (kamida bittasi kerak) ---
# Asosiy model: claude | openai | gemini
DEFAULT_PROVIDER=claude
# Claude kaliti: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ChatGPT kaliti: https://platform.openai.com
OPENAI_API_KEY=
# Gemini kaliti: https://aistudio.google.com
GEMINI_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-flash

# --- O'zbekcha ovoz (ElevenLabs): https://elevenlabs.io ---
ELEVENLABS_API_KEY=
# O'z ovozingizni klonlagach (clone_voice.py) shu yerga yozing
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v1
LANGUAGE_CODE=uz

# --- Telegram: @BotFather dan token oling ---
TELEGRAM_BOT_TOKEN=
